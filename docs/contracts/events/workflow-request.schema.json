{
  "$id": "https://opportunityos.invalid/contracts/events/workflow-request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Durable request written by the API in the same transaction as the command (ADR-003). The dispatcher starts a DBOS workflow whose ID equals requestId, so lost acknowledgements and duplicate dispatch start at most one workflow.",
  "properties": {
    "input": {
      "additionalProperties": false,
      "properties": {
        "contractRef": {
          "$ref": "../common.schema.json#/$defs/VersionRef"
        },
        "estimatedCost": {
          "$ref": "../common.schema.json#/$defs/Money",
          "description": "Run estimate checked against the remaining allowance at request time (R-07). Each task still reserves its own cost before dispatch (R-34)."
        },
        "packageRef": {
          "$ref": "../common.schema.json#/$defs/VersionRef"
        },
        "revisionId": {
          "$ref": "../common.schema.json#/$defs/Uuid"
        },
        "sceneIds": {
          "items": {
            "$ref": "../common.schema.json#/$defs/LocalId"
          },
          "maxItems": 24,
          "type": "array"
        },
        "scriptRef": {
          "$ref": "../common.schema.json#/$defs/VersionRef"
        },
        "storyboardRef": {
          "$ref": "../common.schema.json#/$defs/VersionRef"
        }
      },
      "type": "object"
    },
    "notBefore": {
      "$ref": "../common.schema.json#/$defs/Timestamp"
    },
    "projectId": {
      "$ref": "../common.schema.json#/$defs/Uuid"
    },
    "requestId": {
      "$ref": "../common.schema.json#/$defs/Uuid"
    },
    "requestedBy": {
      "$ref": "../common.schema.json#/$defs/Actor"
    },
    "workflowType": {
      "enum": [
        "research",
        "script",
        "storyboard",
        "narration",
        "preview",
        "master",
        "revision",
        "revision_redraft",
        "package_build",
        "export_build",
        "data_export",
        "retention_sweep",
        "project_deletion",
        "diagnostic"
      ]
    }
  },
  "required": [
    "requestId",
    "workflowType",
    "projectId",
    "requestedBy",
    "input"
  ],
  "title": "WorkflowRequest",
  "type": "object",
  "x-version": "0.4.0"
}

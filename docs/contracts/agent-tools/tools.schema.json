{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opportunityos.invalid/contracts/agent-tools/tools.schema.json",
  "x-version": "0.1.0",
  "title": "Agent tools",
  "description": "Tools a model may call during a bounded task (R-63). Every tool is read-only: none writes domain records, spends budget beyond the task reservation, approves, or publishes (R-43). Tool results that carry outside content are marked untrusted and are never treated as instructions (NFR-05). The worker persists task outputs only after validating them against task-io.schema.json.",
  "$defs": {
    "search_sources.input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["query"],
      "properties": {
        "query": { "type": "string", "minLength": 2, "maxLength": 200 },
        "maxResults": { "type": "integer", "minimum": 1, "maximum": 10, "default": 5 }
      }
    },
    "search_sources.output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["results"],
      "properties": {
        "results": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["resultId", "title", "url"],
            "properties": {
              "resultId": { "$ref": "../common.schema.json#/$defs/LocalId" },
              "title": { "type": "string", "maxLength": 300 },
              "url": { "type": "string", "format": "uri", "maxLength": 2000 },
              "snippet": { "type": "string", "maxLength": 500, "description": "Untrusted." }
            }
          }
        }
      }
    },
    "fetch_source.input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url"],
      "properties": {
        "url": { "type": "string", "format": "uri", "pattern": "^https://", "maxLength": 2000 }
      },
      "description": "Fetched by SourceFetcher (ADR-009): HTTPS only, no private-network or metadata addresses, at most 3 redirects, size cap 5 MB, HTML/PDF/plain text only."
    },
    "fetch_source.output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "finalUrl", "retrievedAt", "contentType", "untrustedText", "truncated"],
      "properties": {
        "sourceId": { "$ref": "../common.schema.json#/$defs/Uuid", "description": "Source record created for provenance; claims cite this ID." },
        "finalUrl": { "type": "string", "format": "uri", "maxLength": 2000 },
        "title": { "type": "string", "maxLength": 300 },
        "publisher": { "type": "string", "maxLength": 200 },
        "publishedAt": { "type": "string", "maxLength": 40 },
        "retrievedAt": { "$ref": "../common.schema.json#/$defs/Timestamp" },
        "contentType": { "enum": ["text/html", "application/pdf", "text/plain"] },
        "untrustedText": { "type": "string", "maxLength": 60000, "description": "Extracted text, wrapped in untrusted-content delimiters when placed in the prompt. Not stored beyond the task; only short excerpts are kept (A-25)." },
        "truncated": { "type": "boolean" }
      }
    },
    "compute_demonstration.input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["function", "params"],
      "properties": {
        "function": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$" },
        "params": { "type": "object", "maxProperties": 20 }
      },
      "description": "Runs an allowlisted function from capabilities.json → demonstrationFunctions. Deterministic, no side effects. Persisting a DemonstrationModel needs Gate B review."
    },
    "compute_demonstration.output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok"],
      "properties": {
        "ok": { "type": "boolean" },
        "results": { "type": "object" },
        "resultsSha256": { "$ref": "../common.schema.json#/$defs/Sha256" },
        "error": { "type": "string", "maxLength": 300, "description": "Domain error, e.g. n outside 1..12." }
      }
    },
    "list_capabilities.input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "list_capabilities.output": {
      "type": "object",
      "description": "The capability catalogue (media/capabilities.json)."
    },
    "validate_scene_spec.input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["videoSpec"],
      "properties": {
        "videoSpec": { "$ref": "../media/video-spec.schema.json" }
      }
    },
    "validate_scene_spec.output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valid", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "errors": {
          "type": "array",
          "maxItems": 200,
          "items": { "$ref": "../media/render-job.schema.json#/$defs/ValidationError" }
        }
      },
      "description": "Dry-run compile (render job kind = validate). No pixels rendered."
    }
  }
}

{
  "$defs": {
    "BriefSummary": {
      "additionalProperties": false,
      "properties": {
        "audience": {
          "maxLength": 300,
          "type": "string"
        },
        "contractRef": {
          "$ref": "../common.schema.json#/$defs/VersionRef"
        },
        "promise": {
          "maxLength": 300,
          "type": "string"
        },
        "proposedFamilies": {
          "items": {
            "maxLength": 40,
            "type": "string"
          },
          "maxItems": 6,
          "type": "array"
        },
        "series": {
          "$ref": "#/$defs/Series"
        },
        "targetDurationSec": {
          "maximum": 90,
          "minimum": 30,
          "type": "integer"
        },
        "viewerQuestion": {
          "maxLength": 300,
          "type": "string"
        }
      },
      "required": [
        "contractRef",
        "series",
        "audience",
        "viewerQuestion",
        "promise"
      ],
      "type": "object"
    },
    "DiagnosticEchoInput": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "description": "Synthetic diagnostic string (A-43).",
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "type": "object"
    },
    "DiagnosticEchoOutput": {
      "additionalProperties": false,
      "properties": {
        "modelId": {
          "maxLength": 120,
          "minLength": 1,
          "type": "string"
        },
        "text": {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "text",
        "modelId"
      ],
      "type": "object"
    },
    "ResearchInput": {
      "additionalProperties": false,
      "properties": {
        "brief": {
          "$ref": "#/$defs/BriefSummary"
        },
        "existingClaims": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "claimId": {
                "$ref": "../common.schema.json#/$defs/Uuid"
              },
              "text": {
                "maxLength": 500,
                "type": "string"
              }
            },
            "required": [
              "claimId",
              "text"
            ],
            "type": "object"
          },
          "maxItems": 100,
          "type": "array"
        },
        "operatorSourceUrls": {
          "description": "Sources the operator supplied; fetched first.",
          "items": {
            "format": "uri",
            "maxLength": 2000,
            "type": "string"
          },
          "maxItems": 20,
          "type": "array"
        }
      },
      "required": [
        "brief"
      ],
      "type": "object"
    },
    "ResearchOutput": {
      "additionalProperties": false,
      "properties": {
        "claims": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "claimType": {
                "enum": [
                  "fact",
                  "definition",
                  "calculation",
                  "derivation",
                  "statistic",
                  "historical",
                  "opinion"
                ]
              },
              "evidence": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "excerpt": {
                      "description": "Under 25 words (A-25). Checked against the fetched text; a non-matching excerpt marks the citation invalid (R-08 AC2).",
                      "maxLength": 200,
                      "type": "string"
                    },
                    "locator": {
                      "description": "Section heading, page, or a quote fragment that locates the text.",
                      "maxLength": 200,
                      "type": "string"
                    },
                    "sourceId": {
                      "$ref": "../common.schema.json#/$defs/Uuid",
                      "description": "Must be a sourceId returned by fetch_source in this task."
                    },
                    "stance": {
                      "enum": [
                        "supports",
                        "partially_supports",
                        "contradicts"
                      ]
                    }
                  },
                  "required": [
                    "sourceId",
                    "stance",
                    "locator"
                  ],
                  "type": "object"
                },
                "maxItems": 6,
                "type": "array"
              },
              "localId": {
                "$ref": "../common.schema.json#/$defs/LocalId"
              },
              "materiality": {
                "enum": [
                  "material",
                  "supporting"
                ]
              },
              "needsSpecialist": {
                "description": "Health, finance, advanced science or legal (A-04). Blocks approval until a specialist clears it (R-09).",
                "type": "boolean"
              },
              "notes": {
                "maxLength": 500,
                "type": "string"
              },
              "text": {
                "maxLength": 500,
                "type": "string"
              }
            },
            "required": [
              "localId",
              "text",
              "claimType",
              "materiality",
              "evidence",
              "needsSpecialist"
            ],
            "type": "object"
          },
          "maxItems": 60,
          "type": "array"
        },
        "gaps": {
          "description": "What could not be supported. Unsupported claims are listed here, not invented.",
          "items": {
            "maxLength": 300,
            "type": "string"
          },
          "maxItems": 20,
          "type": "array"
        },
        "suggestedDemonstration": {
          "additionalProperties": false,
          "properties": {
            "function": {
              "maxLength": 64,
              "type": "string"
            },
            "params": {
              "type": "object"
            },
            "rationale": {
              "maxLength": 300,
              "type": "string"
            }
          },
          "type": "object"
        }
      },
      "required": [
        "claims",
        "gaps"
      ],
      "type": "object"
    },
    "RevisionScope": {
      "additionalProperties": false,
      "description": "Q-34: redraft only these beats (script) or scenes (storyboard). Anything else must equal the previous version, or the result fails with out_of_scope_change.",
      "properties": {
        "revisionId": {
          "$ref": "../common.schema.json#/$defs/Uuid"
        },
        "targetIds": {
          "items": {
            "maxLength": 100,
            "type": "string"
          },
          "maxItems": 12,
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "revisionId",
        "targetIds"
      ],
      "type": "object"
    },
    "ScriptInput": {
      "additionalProperties": false,
      "properties": {
        "brief": {
          "$ref": "#/$defs/BriefSummary"
        },
        "claims": {
          "description": "Only approved or accurately qualified claims are given to the script task (R-09).",
          "items": {
            "additionalProperties": false,
            "properties": {
              "claimId": {
                "$ref": "../common.schema.json#/$defs/Uuid"
              },
              "reviewStatus": {
                "enum": [
                  "approved",
                  "qualified"
                ]
              },
              "text": {
                "maxLength": 500,
                "type": "string"
              }
            },
            "required": [
              "claimId",
              "text",
              "reviewStatus"
            ],
            "type": "object"
          },
          "maxItems": 60,
          "type": "array"
        },
        "demonstration": {
          "$ref": "../media/demonstration.schema.json"
        },
        "previousScript": {
          "$ref": "#/$defs/ScriptOutput"
        },
        "revisionRequest": {
          "description": "Operator instruction when revising an existing version.",
          "maxLength": 1000,
          "type": "string"
        },
        "revisionScope": {
          "$ref": "#/$defs/RevisionScope"
        }
      },
      "required": [
        "brief",
        "claims"
      ],
      "type": "object"
    },
    "ScriptOutput": {
      "additionalProperties": false,
      "properties": {
        "beats": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "../common.schema.json#/$defs/LocalId"
              },
              "intent": {
                "maxLength": 200,
                "type": "string"
              },
              "kind": {
                "enum": [
                  "hook",
                  "setup",
                  "demonstration",
                  "explanation",
                  "payoff",
                  "closure"
                ]
              },
              "segments": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "claimIds": {
                      "items": {
                        "$ref": "../common.schema.json#/$defs/Uuid"
                      },
                      "maxItems": 10,
                      "type": "array"
                    },
                    "id": {
                      "$ref": "../common.schema.json#/$defs/LocalId"
                    },
                    "pronunciationHints": {
                      "items": {
                        "additionalProperties": false,
                        "properties": {
                          "say": {
                            "maxLength": 80,
                            "type": "string"
                          },
                          "text": {
                            "maxLength": 40,
                            "type": "string"
                          }
                        },
                        "required": [
                          "text",
                          "say"
                        ],
                        "type": "object"
                      },
                      "maxItems": 10,
                      "type": "array"
                    },
                    "text": {
                      "maxLength": 400,
                      "minLength": 1,
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "text",
                    "claimIds"
                  ],
                  "type": "object"
                },
                "maxItems": 10,
                "minItems": 1,
                "type": "array"
              }
            },
            "required": [
              "id",
              "kind",
              "intent",
              "segments"
            ],
            "type": "object"
          },
          "maxItems": 12,
          "minItems": 3,
          "type": "array"
        },
        "estimatedWords": {
          "maximum": 400,
          "minimum": 0,
          "type": "integer"
        },
        "series": {
          "$ref": "#/$defs/Series"
        },
        "title": {
          "maxLength": 100,
          "type": "string"
        }
      },
      "required": [
        "series",
        "beats"
      ],
      "type": "object"
    },
    "Series": {
      "enum": [
        "what_if",
        "wait_how_does_that_work",
        "solve_this",
        "inside_the_machine"
      ]
    },
    "StoryboardInput": {
      "additionalProperties": false,
      "properties": {
        "brandKit": {
          "$ref": "../common.schema.json#/$defs/VersionRef"
        },
        "brief": {
          "$ref": "#/$defs/BriefSummary"
        },
        "demonstrations": {
          "items": {
            "$ref": "../media/demonstration.schema.json"
          },
          "maxItems": 8,
          "type": "array"
        },
        "previousSpec": {
          "$ref": "../media/video-spec.schema.json"
        },
        "revisionRequest": {
          "maxLength": 1000,
          "type": "string"
        },
        "revisionScope": {
          "$ref": "#/$defs/RevisionScope"
        },
        "script": {
          "$ref": "#/$defs/ScriptOutput"
        },
        "scriptRef": {
          "$ref": "../common.schema.json#/$defs/VersionRef"
        }
      },
      "required": [
        "brief",
        "script",
        "brandKit",
        "demonstrations"
      ],
      "type": "object"
    },
    "StoryboardOutput": {
      "additionalProperties": false,
      "properties": {
        "sceneNotes": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "note": {
                "maxLength": 300,
                "type": "string"
              },
              "sceneId": {
                "$ref": "../common.schema.json#/$defs/LocalId"
              }
            },
            "required": [
              "sceneId",
              "note"
            ],
            "type": "object"
          },
          "maxItems": 24,
          "type": "array"
        },
        "unsupportedNeeds": {
          "description": "Visual operations the catalogue lacks (R-07). Shown to the operator before any paid production.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "description": {
                "maxLength": 300,
                "type": "string"
              },
              "sceneId": {
                "$ref": "../common.schema.json#/$defs/LocalId"
              }
            },
            "required": [
              "description"
            ],
            "type": "object"
          },
          "maxItems": 20,
          "type": "array"
        },
        "videoSpec": {
          "$ref": "../media/video-spec.schema.json",
          "description": "timing.status must be provisional."
        }
      },
      "required": [
        "videoSpec",
        "unsupportedNeeds"
      ],
      "type": "object"
    }
  },
  "$id": "https://opportunityos.invalid/contracts/agent-tools/task-io.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Input and output schemas for the three bounded model tasks (R-63, PRD §14.1). Outputs are proposals: they become draft records that a member reviews at Gates B and C. Nothing here is an approval.",
  "title": "Agent task inputs and outputs",
  "x-version": "0.4.0"
}

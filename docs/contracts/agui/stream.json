{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://opportunityos.invalid/contracts/agui/stream.json",
 "x-version": "0.3.0",
 "title": "AG-UI project event stream",
 "description": "How GET /projects/{projectId}/events encodes run progress and domain events as AG-UI events (ADR-020, docs/architecture/AGENT_ARCHITECTURE.md). Event shapes are the pinned AG-UI SDK's (ag-ui-protocol for Python, @ag-ui/core for TypeScript); this file fixes only how OpportunityOS uses them. Events carry no authority.",
 "x-agui": {
  "sdk": {
   "python": "ag-ui-protocol",
   "typescript": "@ag-ui/core",
   "pin": "exact versions in the M0 lockfiles; upgrades are their own spec (pre-1.0)"
  },
  "transport": "text/event-stream; one stream per open project; Last-Event-ID resumes",
  "threadId": "projectId",
  "runId": "execution_run.id",
  "runStartedBy": "REST command returning 202 (observe mode); the AG-UI run request is not used at R1-R2",
  "eventsUsed": [
   "RUN_STARTED",
   "RUN_FINISHED",
   "RUN_ERROR",
   "STEP_STARTED",
   "STEP_FINISHED",
   "TOOL_CALL_START",
   "TOOL_CALL_ARGS",
   "TOOL_CALL_END",
   "TOOL_CALL_RESULT",
   "ACTIVITY_SNAPSHOT",
   "ACTIVITY_DELTA",
   "STATE_SNAPSHOT",
   "CUSTOM"
  ],
  "eventsNotUsed": [
   "TEXT_MESSAGE_START",
   "TEXT_MESSAGE_CONTENT",
   "TEXT_MESSAGE_END",
   "TEXT_MESSAGE_CHUNK",
   "TOOL_CALL_CHUNK",
   "STATE_DELTA",
   "MESSAGES_SNAPSHOT",
   "RAW",
   "reasoning and sub-agent events"
  ],
  "onConnect": "STATE_SNAPSHOT first (schema #/$defs/ProjectRunState), then live events",
  "mapping": [
   {
    "source": "run.state_changed to running",
    "event": "RUN_STARTED"
   },
   {
    "source": "run.state_changed to succeeded",
    "event": "RUN_FINISHED"
   },
   {
    "source": "run.state_changed to failed, or run.cancelled",
    "event": "RUN_ERROR",
    "code": "#/$defs/RunErrorCode"
   },
   {
    "source": "workflow step or task_attempt.started / task_attempt.finished",
    "event": "STEP_STARTED / STEP_FINISHED",
    "stepName": "#/$defs/StepName"
   },
   {
    "source": "agent tool call inside a task attempt",
    "event": "TOOL_CALL_START, TOOL_CALL_ARGS, TOOL_CALL_END, TOOL_CALL_RESULT",
    "args": "#/$defs/ToolCallArgsSummary",
    "result": "#/$defs/ToolCallResultSummary"
   },
   {
    "source": "render progress, budget or approval pause",
    "event": "ACTIVITY_SNAPSHOT / ACTIVITY_DELTA",
    "activityType": "#/$defs/ActivityType"
   },
   {
    "source": "every DomainEvent",
    "event": "CUSTOM",
    "name": "opportunityos.<DomainEvent.type>",
    "value": "../events/domain-event.schema.json"
   }
  ]
 },
 "$defs": {
  "RunErrorCode": {
   "$ref": "../common.schema.json#/$defs/ErrorClass"
  },
  "StepName": {
   "type": "string",
   "description": "Workflow step names shown in the run indicator and S-13.",
   "pattern": "^(research|script|storyboard|demonstration|narration|tts\\.scene\\.[a-z0-9_.-]+|alignment|captions|compile|render\\.clip\\.scene\\.[a-z0-9_.-]+|assembly|mix|qa|package_build|export_build|budget\\.reserve|budget\\.settle)$"
  },
  "ActivityType": {
   "enum": [
    "opportunityos.render_progress",
    "opportunityos.run_paused"
   ]
  },
  "RenderProgress": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "scenes"
   ],
   "properties": {
    "scenes": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "sceneId",
       "status"
      ],
      "properties": {
       "sceneId": {
        "type": "string"
       },
       "status": {
        "enum": [
         "queued",
         "rendering",
         "reused",
         "done",
         "failed"
        ]
       },
       "percent": {
        "type": "integer",
        "minimum": 0,
        "maximum": 100
       }
      }
     }
    }
   }
  },
  "RunPaused": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "reason"
   ],
   "properties": {
    "reason": {
     "enum": [
      "budget",
      "awaiting_approval",
      "manual_takeover"
     ]
    },
    "unblockAction": {
     "type": "string",
     "description": "The one Studio action that unblocks the run, e.g. raise_allowance."
    }
   }
  },
  "ToolCallArgsSummary": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "tool"
   ],
   "description": "Never page text, prompts, model output, secrets or signed URLs (SECURITY TH-31).",
   "properties": {
    "tool": {
     "enum": [
      "search_sources",
      "fetch_source",
      "compute_demonstration",
      "list_capabilities",
      "validate_scene_spec"
     ]
    },
    "domain": {
     "type": "string",
     "description": "Host of a fetched URL only, e.g. example.org"
    },
    "queryCount": {
     "type": "integer",
     "minimum": 0
    }
   }
  },
  "ToolCallResultSummary": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "outcome"
   ],
   "properties": {
    "outcome": {
     "enum": [
      "ok",
      "refused",
      "failed"
     ]
    },
    "reason": {
     "type": "string",
     "maxLength": 80
    },
    "count": {
     "type": "integer",
     "minimum": 0
    }
   }
  },
  "ProjectRunState": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "projectId",
    "activeRuns"
   ],
   "properties": {
    "projectId": {
     "$ref": "../common.schema.json#/$defs/Uuid"
    },
    "activeRuns": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "runId",
       "workflowType",
       "status"
      ],
      "properties": {
       "runId": {
        "$ref": "../common.schema.json#/$defs/Uuid"
       },
       "workflowType": {
        "type": "string"
       },
       "status": {
        "enum": [
         "running",
         "paused"
        ]
       },
       "currentStep": {
        "$ref": "#/$defs/StepName"
       },
       "stepIndex": {
        "type": "integer",
        "minimum": 1
       },
       "stepCount": {
        "type": "integer",
        "minimum": 1
       }
      }
     }
    }
   }
  }
 }
}
# OpportunityOS local configuration (SPEC-01a). `make setup` copies this file to .env
# (git-ignored) only when .env is absent. Values here are safe, local-only placeholders:
# never put a real credential in this file. Inventory and rules:
# docs/architecture/SECURITY.md#secrets-and-credentials (NFR-06, NFR-13).

# --- Environment and feature flags (ADR-022: FEATURE_* read at start-up) ---
APP_ENV=dev
# A-43: the diagnostic run and System check; on in dev and staging, off in production.
FEATURE_DIAGNOSTICS=1

# --- Host ports, all bound to 127.0.0.1 (change one if it is taken on your machine) ---
WEB_HOST_PORT=3000
API_HOST_PORT=8000
KEYCLOAK_HOST_PORT=8180
GRAFANA_HOST_PORT=3001
OBJECTSTORE_HOST_PORT=9000

# --- PostgreSQL bootstrap owner (used by make migrate until SPEC-04 adds roles) ---
POSTGRES_USER=oos_owner
POSTGRES_PASSWORD=change-me-local-postgres
POSTGRES_DB=opportunityos

# --- Per-service database passwords (roles and grants: SPEC-04) ---
DB_PASSWORD_API=change-me-local-db-api
DB_PASSWORD_WORKER=change-me-local-db-worker
DB_PASSWORD_RENDER=change-me-local-db-render
DB_PASSWORD_RETENTION=change-me-local-db-retention
DB_PASSWORD_ANALYTICS_RO=change-me-local-db-analytics-ro

# --- Object store (interim, ADR-015) and per-service storage keys (policies: SPEC-05) ---
OBJECTSTORE_ROOT_USER=oos-root
OBJECTSTORE_ROOT_PASSWORD=change-me-local-objectstore
STORAGE_ACCESS_KEY_WORKER=change-me-local-worker
STORAGE_SECRET_KEY_WORKER=change-me-local-storage-worker
STORAGE_ACCESS_KEY_RENDER=change-me-local-render
STORAGE_SECRET_KEY_RENDER=change-me-local-storage-render
STORAGE_ACCESS_KEY_RETENTION=change-me-local-retention
STORAGE_SECRET_KEY_RETENTION=change-me-local-storage-retention
STORAGE_ACCESS_KEY_API_SIGNER=change-me-local-api-signer
STORAGE_SECRET_KEY_API_SIGNER=change-me-local-storage-api-signer

# --- Identity (Keycloak locally, ADR-012; realm: SPEC-06) ---
KEYCLOAK_ADMIN_USERNAME=oos-admin
KEYCLOAK_ADMIN_PASSWORD=change-me-local-keycloak-admin
KEYCLOAK_CLIENT_SECRET=change-me-local-keycloak-client
AUTH_SECRET=change-me-local-auth-secret

# --- Providers: fakes by default; empty until a live call is needed (Q-05) ---
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
# Q-29: search API not chosen yet.
SEARCH_API_KEY=

# --- Alerts (Grafana email contact point, ADR-016) ---
SMTP_PASSWORD=

# --- R3 only (not used before R3) ---
TOKEN_ENCRYPTION_KEY=
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=

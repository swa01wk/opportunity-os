# Every base and service image, pinned by digest (SPEC-01a AC4, ADR-022). One owner for pins:
# compose.yaml and docker/*.Dockerfile read these names. Refresh digests with infra/pin.sh;
# Renovate proposes tag updates (ADR-019). Tags were chosen from TECH_STACK.md version lines.
PYTHON_IMAGE=python:3.13-slim-trixie
UV_IMAGE=ghcr.io/astral-sh/uv:0.11.32
NODE_IMAGE=node:24-bookworm-slim
BUSYBOX_IMAGE=busybox:1.37-uclibc
GOLANG_IMAGE=golang:1.25-bookworm
POSTGRES_IMAGE=postgres:17-trixie
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.8.2
OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.151.0
LGTM_IMAGE=grafana/otel-lgtm:0.28.0
GITLEAKS_IMAGE=zricethezav/gitleaks:v8.30.1
# Interim object store (ADR-015): built from the final MinIO CE source tag, because the
# official images were withdrawn from Docker Hub and quay.io. SPEC-05 replaces it.
MINIO_SOURCE_REF=RELEASE.2025-10-15T17-29-55Z

#!/bin/sh
# gitleaks on staged changes before every commit (SECURITY.md, ADR-019). Installed by
# `make setup` (git config core.hooksPath infra/git-hooks). Runs in a container.
set -eu
root=$(git rev-parse --show-toplevel)
image=$(sed -n 's/^GITLEAKS_IMAGE=//p' "$root/infra/images.env")
exec docker run --rm -v "$root:/repo" -w /repo "$image" git --pre-commit --staged --redact --no-banner /repo

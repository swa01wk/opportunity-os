  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "HTTP request rate per service (NFR-15, AC4).",
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "targets": [
        {
          "expr": "sum by (service_name) (rate(http_server_duration_count[5m]))",
          "legendFormat": "{{service_name}}"
        }
      ],
      "title": "Request rate by service",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "HTTP 5xx ratio per service.",
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "targets": [
        {
          "expr": "sum by (service_name) (rate(http_server_duration_count{http_status_code=~\"5..\"}[5m])) / sum by (service_name) (rate(http_server_duration_count[5m]))",
          "legendFormat": "{{service_name}}"
        }
      ],
      "title": "Error rate by service",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "P95 request duration.",
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 3,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, service_name) (rate(http_server_duration_bucket[5m])))",
          "legendFormat": "{{service_name}}"
        }
      ],
      "title": "P95 duration by service",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Targets reporting metrics for each OpportunityOS service.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 4,
      "options": { "showHeader": true },
      "targets": [
        {
          "expr": "group by (service_name) (target_info{service_name=~\"api|worker|web|render|otel-collector|lgtm\"})",
          "format": "table",
          "instant": true
        }
      ],
      "title": "Stack health (services seen in telemetry)",
      "type": "table"
    },
    {
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 16 },
      "id": 5,
      "options": { "content": "PostgreSQL `pg.slow_query` threshold: **500 ms** (OBSERVABILITY.md).", "mode": "markdown" },
      "title": "PostgreSQL slow-query threshold",
      "type": "text"
    }
  ],
